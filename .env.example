# Copy to .env and replace placeholders.
COMPOSE_PROJECT_NAME=document-wiki-c2
APP_ENV_FILE=.env
# Thẻ ảnh dựng cục bộ, ghim theo phiên bản (không dùng thẻ trôi nổi)
BACKEND_IMAGE=wiki-c2-backend:0.1.0
FRONTEND_IMAGE=wiki-c2-frontend:0.1.0

# --- Host ports (document-wiki original uses 5055 / 3119 / 9002 / 9003 / 19530 / 9091 / 9004) ---
API_PORT=5155
FRONTEND_PORT=3219
MINIO_API_PORT=9102
MINIO_CONSOLE_PORT=9103
MILVUS_PORT_HOST=19630
MILVUS_HEALTH_PORT=9191
ATTU_PORT=9104

CAHY_NETWORK_NAME=cahy-internal
API_NETWORK_ALIAS=wiki2_api
POSTGRES_ALIAS=wiki2_postgres

# Mật khẩu CSDL: sinh ngẫu nhiên rồi điền vào cả POSTGRES_PASSWORD và chỗ <POSTGRES_PASSWORD> trong DATABASE_URL
DATABASE_URL=postgresql+asyncpg://arkon:<POSTGRES_PASSWORD>@wiki2_postgres:5432/arkon
POSTGRES_USER=arkon
POSTGRES_PASSWORD=
POSTGRES_DB=arkon

# prod (mặc định): từ chối khởi động khi SECRET_KEY / MCP_TOKEN_PEPPER trống hoặc còn "change-me"; dev: chỉ cảnh báo
APP_ENV=prod
# BẮT BUỘC sinh ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# 64 ký tự hex ký nhật ký kiểm toán: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=
# BẮT BUỘC sinh ngẫu nhiên (muối băm token MCP); đổi giá trị = mọi token MCP đã cấp hết hiệu lực
MCP_TOKEN_PEPPER=
DEFAULT_ADMIN_EMAIL=admin@arkon.local
DEFAULT_ADMIN_PASSWORD=

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=arkon-files
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_HOURS=24

# Chỉ các miền giao diện được gọi API, phân cách bằng dấu phẩy; không dùng *
CORS_ORIGINS=https://wiki.ai.cahy.io.vn,https://ai.cahy.io.vn
PORTAL_BASE_URL=

REDIS_HOST=redis
REDIS_PORT=6379
# sinh ngẫu nhiên; phải trùng giá trị redis-server nhận trong docker-compose.yml
REDIS_PASSWORD=
REDIS_DB=0
WORKER_MAX_JOBS=3
WORKER_JOB_TIMEOUT=7200

SSO_ENABLED=false
SSO_ISSUER=
SSO_INTERNAL_ISSUER=
SSO_CLIENT_ID=cahy-wiki
SSO_CLIENT_SECRET=
SSO_SCOPES=openid email profile
SSO_PROVIDER_NAME=Công an tỉnh (SSO)
SSO_AUTO_REDIRECT=false
SSO_ALLOW_PASSWORD_LOGIN=true
SSO_ADMIN_ROLES=admin
SSO_ROLE_GLOBAL_MAP=qt-dl:knowledge_manager,qt-nd:viewer,qt-ai:contributor,qt-ht:viewer
SSO_DEFAULT_GLOBAL_ROLE=viewer
SSO_SYNC_ROLES=true
SSO_SYNC_DEPARTMENTS=true
SSO_GROUP_DEPARTMENT_MAP=
SSO_TRUST_EMAIL=false
SSO_MCP_CLIENTS=cahy-chatbot
CHATBOT_URL=
CHATBOT_WIKI_SSO_SECRET=
MCP_TRUST_FORWARDED_IDENTITY=false

MRP_AUTO_APPROVE_PLAN=true
MRP_MULTIPASS_WRITER_ENABLED=true
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,xlsx,pptx,txt,md,csv
AUTO_APPROVE_EXTRACTION_THRESHOLD_TOKENS=0
EXTRACTION_APPROVAL_TTL_HOURS=24
MAX_AUTO_RECOVER_ATTEMPTS=3

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse tự host trong mạng nội bộ (vd http://langfuse-web:3000); để trống = không gửi trace đi đâu
LANGFUSE_HOST=
LANGFUSE_BASE_URL=

MILVUS_ENABLED=false
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default

OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=ggml-org/GLM-OCR-GGUF:f16

RERANKER_ENABLED=true
RERANKER_PROVIDER=http
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=10

CHUNK_TARGET_TOKENS=1500
CHUNK_OVERLAP_TOKENS=150

CAHY_NETWORK_NAME=cahy-internal
