ARG RUNTIME_BASE=cahy-wiki-backend:quality-261022-1bb420a2
FROM ${RUNTIME_BASE}
COPY app/database/models.py /app/app/database/models.py
COPY app/services/legal_relation_extractor.py /app/app/services/legal_relation_extractor.py
COPY app/services/legal_service.py /app/app/services/legal_service.py
COPY app/mcp/tools.py /app/app/mcp/tools.py
